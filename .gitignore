*.beam
*.ez
/build
erl_crash.dump
.DS_Store

# Editor and tool scratch files
*.swp
*~
.idea/
.vscode/
.playwright-mcp/
# MCP servers are per machine (they name local paths); not shared config.
/.mcp.json
__pycache__/
*.pyc
node_modules/

# Example build artifacts
/examples/*/build

# Auto-generated by build system (`gleam run -m beacon/build`). An example
# is built before it runs, so its codec and client bundle are not tracked.
# The root priv/static bundle is tracked: the framework's own tests serve it.
beacon_runtime_entry.mjs
src/beacon_codec.gleam
examples/*/src/beacon_codec.gleam
/examples/*/priv/static/
src/generated/

# Client build artifacts (compiled JS in build dir)
beacon_client/build/

# The copy of beacon_client/src that scripts/publish.sh stages for the Hex
# tarball and removes on exit.
/priv/beacon_client_src/

# Secrets & credentials
.env
.env.*
.venv/
.tmp/
*.pem
*.key
secrets/
.hex_api_key

# Test scripts (local dev only)
test_cdp*.py
test_cdp*.sh
!test_all_cdp.py

# TLS distribution test fixtures: test-only keys (see regenerate.sh there)
!test/fixtures/dist_tls/*.pem
!test/fixtures/dist_tls/*.key
