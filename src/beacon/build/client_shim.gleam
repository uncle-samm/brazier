//// The JavaScript-target version of `beacon/log` the client project compiles
//// against.
////
//// The server `beacon/log` configures the Erlang `logger` through the
//// `logging` package, which has no JavaScript implementation. Client code
//// (the app's view and the rendering core) logs through the same four
//// functions, so the shim keeps that API and prints to the browser console:
//// debug and info to `console.log`, warnings and errors to `console.error`.

/// The client `beacon/log` module.
pub const log_module =
  "/// AUTO-GENERATED by beacon/build.
/// The `beacon/log` API for the JavaScript target, printing to the console.
import gleam/io

pub fn debug(module: String, message: String) -> Nil {
  io.println(line(\"DEBUG\", module, message))
}

pub fn info(module: String, message: String) -> Nil {
  io.println(line(\"INFO\", module, message))
}

pub fn warning(module: String, message: String) -> Nil {
  io.println_error(line(\"WARN\", module, message))
}

pub fn error(module: String, message: String) -> Nil {
  io.println_error(line(\"ERROR\", module, message))
}

fn line(level: String, module: String, message: String) -> String {
  level <> \" [\" <> module <> \"] \" <> message
}
"
