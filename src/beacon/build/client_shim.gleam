/// The JavaScript-target versions of the `beacon` and `beacon/log` modules
/// the client project compiles the app's view against.
///
/// The server `beacon` module imports the runtime, transport and other
/// Erlang-only modules, so the client project cannot compile it. Its view
/// helpers (`on_click`, `on_focus`, `keyed`, ...) only build attributes and
/// nodes, so the shim copies each of them from Beacon's own `beacon.gleam`:
/// every public function that returns `Attr` or `Node`. A helper added on the
/// server is therefore in the shim too. A helper that uses anything beyond
/// `beacon/element`, the client handler registry, `gleam/string` and
/// `option.None` cannot be copied and stops the build with its name.
import beacon/build/analyzer
import beacon/build/ast_refs
import beacon/build/files
import beacon/log
import glance
import gleam/bit_array
import gleam/int
import gleam/list
import gleam/option.{None, Some}
import gleam/result
import gleam/set
import gleam/string

/// The imports every copied helper is compiled with in the client project.
const imports = [
  "import beacon/element.{type Attr}", "import beacon_client/handler",
  "import gleam/option.{None}", "import gleam/string",
]

/// Module qualifiers a copied helper may use.
const allowed_qualifiers = ["element", "handler", "string"]

/// Unqualified module-level names a copied helper may use besides its own
/// parameters and local variables.
const allowed_names = [
  "None", "Attr", "Node", "String", "Int", "Bool", "Float", "List", "Nil",
]

/// A view helper copied from the server `beacon` module.
pub type Helper {
  Helper(name: String, arity: Int, source: String)
}

/// The view helpers of the `beacon` module whose source is `source`. Each
/// helper's source text starts at its `pub fn`.
pub fn helpers(path: String, source: String) -> Result(List(Helper), String) {
  use module <- result.try(analyzer.parse(path, source))
  let bytes = bit_array.from_string(source)
  // glance lists definitions in reverse; the shim keeps source order.
  let view_helpers =
    list.filter(module.functions, fn(def) {
      def.definition.publicity == glance.Public
      && returns_view_type(def.definition)
    })
    |> list.sort(fn(a, b) {
      int.compare(a.definition.location.start, b.definition.location.start)
    })
  let helper_names =
    list.map(view_helpers, fn(def) { def.definition.name }) |> set.from_list
  list.try_map(view_helpers, fn(def) {
    let function = def.definition
    use Nil <- result.try(check_references(path, function, helper_names))
    use text <- result.try(slice(path, bytes, function.location))
    Ok(Helper(
      name: function.name,
      arity: list.length(function.parameters),
      source: text,
    ))
  })
}

/// The client `beacon` module, built from the server `beacon.gleam` found
/// under `beacon_root`.
pub fn beacon_module(beacon_root: String) -> Result(String, String) {
  let path = files.join(beacon_root, "src/beacon.gleam")
  use source <- result.try(files.read(path))
  use helpers <- result.try(helpers(path, source))
  log.info(
    "beacon.build.client_shim",
    "Client beacon module has "
      <> string.inspect(list.length(helpers))
      <> " view helpers from "
      <> path,
  )
  Ok(
    string.join(
      [
        "/// AUTO-GENERATED by beacon/build from beacon.gleam.",
        "/// The view helpers of the `beacon` module, for the JavaScript target.",
        string.join(imports, "\n"),
        "/// A node in the virtual DOM tree.\npub type Node(msg) =\n  element.Node(msg)",
        ..list.map(helpers, fn(h) { h.source })
      ],
      "\n\n",
    )
    <> "\n",
  )
}

/// The client `beacon/log` module: the server log API, printing to the
/// browser console.
pub const log_module =
  "/// AUTO-GENERATED by beacon/build.
/// The `beacon/log` API for the JavaScript target, printing to the console.
import gleam/io

pub fn debug(module: String, message: String) -> Nil {
  write(\"DEBUG\", module, message)
}

pub fn info(module: String, message: String) -> Nil {
  write(\"INFO\", module, message)
}

pub fn warning(module: String, message: String) -> Nil {
  write(\"WARN\", module, message)
}

pub fn error(module: String, message: String) -> Nil {
  write(\"ERROR\", module, message)
}

fn write(level: String, module: String, message: String) -> Nil {
  io.println(level <> \" [\" <> module <> \"] \" <> message)
}
"

fn returns_view_type(function: glance.Function) -> Bool {
  case function.return {
    Some(glance.NamedType(name: "Attr", module: None, ..))
    | Some(glance.NamedType(name: "Attr", module: Some("element"), ..))
    | Some(glance.NamedType(name: "Node", module: None, ..))
    | Some(glance.NamedType(name: "Node", module: Some("element"), ..)) -> True
    _ -> False
  }
}

fn check_references(
  path: String,
  function: glance.Function,
  helper_names: set.Set(String),
) -> Result(Nil, String) {
  let refs = ast_refs.function(ast_refs.empty(), function)
  let locals =
    list.append(parameter_names(function), let_names(function.body))
    |> set.from_list
  // glance parses `element.attr` as a field access on a variable named
  // `element`, so a qualifier is also reported as a name.
  let known =
    set.from_list(allowed_names)
    |> set.union(set.from_list(allowed_qualifiers))
    |> set.union(locals)
    |> set.union(helper_names)
  let bad_qualifiers =
    set.to_list(refs.qualifiers)
    |> list.filter(fn(q) {
      !list.contains(allowed_qualifiers, q) && !set.contains(locals, q)
    })
  let bad_names =
    set.to_list(refs.names) |> list.filter(fn(n) { !set.contains(known, n) })
  case
    list.append(bad_qualifiers, bad_names)
    |> list.unique
    |> list.sort(string.compare)
  {
    [] -> Ok(Nil)
    unknown -> {
      let message =
        "Cannot copy view helper `beacon."
        <> function.name
        <> "` from "
        <> path
        <> " into the client bundle: it uses "
        <> string.join(unknown, ", ")
        <> ". Client view helpers may only use beacon/element, the handler registry, gleam/string and option.None."
      log.error("beacon.build.client_shim", message)
      Error(message)
    }
  }
}

fn parameter_names(function: glance.Function) -> List(String) {
  list.filter_map(function.parameters, fn(param) {
    case param.name {
      glance.Named(name) -> Ok(name)
      glance.Discarded(_) -> Error(Nil)
    }
  })
}

fn let_names(body: List(glance.Statement)) -> List(String) {
  list.flat_map(body, fn(statement) {
    case statement {
      glance.Assignment(pattern: glance.PatternVariable(name:, ..), ..) -> [
        name,
      ]
      _ -> []
    }
  })
}

fn slice(
  path: String,
  bytes: BitArray,
  span: glance.Span,
) -> Result(String, String) {
  bit_array.slice(bytes, span.start, span.end - span.start)
  |> result.try(bit_array.to_string)
  |> result.map_error(fn(_: Nil) {
    "Cannot slice source span "
    <> string.inspect(span.start)
    <> ".."
    <> string.inspect(span.end)
    <> " of "
    <> path
  })
}
