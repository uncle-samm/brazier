/// Generates `beacon_app_entry.gleam`, the module the client bundle exposes
/// to `beacon_client_ffi.mjs` as `window.BeaconApp`.
///
/// The client runtime calls these exports by name:
///
/// - `init_local(model)`: the first Local state, or `Nil` without Local.
/// - `start_render()`, `finish_render()` and `resolve_handler(registry, id,
///   data)`: the event handler registry around a client render.
/// - `view_to_html(model, local)`: the view as HTML.
/// - `decode_model(json)` and `decode_local(json)`: Model and Local from a
///   `model_sync` payload. `decode_local` exists only with Local.
/// - `encode_model(model, local)`: Model and Local fields as JSON, for diffing.
/// - `encode_msg(msg)`: the `{"tag": .., "argN": ..}` JSON the server's
///   `decode_event` reads.
/// - `update(model, local, msg)` and `msg_affects_model(msg)`: only for apps
///   with Local and no private Server state, whose update runs in the browser.
import beacon/build/analyzer.{type Analysis, type MsgVariant, type TypeField}
import beacon/build/codec_gen.{type Codecs}
import beacon/build/field_type.{type FieldType}
import beacon/build/gleam_code.{
  type Definition, type Expr, type TypeExpr, Arg, Block, Call, Case, Clause,
  ExprStmt, FieldAccess, Function, Import, Let, Module, PCtor, PDiscard, PTuple,
  PVar, Param, Pipe, Ref, Str, TNamed, TTuple, TupleExpr, Var,
}
import beacon/build/messages.{type MsgType}
import beacon/log
import gleam/int
import gleam/list
import gleam/option.{None, Some}
import gleam/result

/// The alias the entry module imports the client app module under.
const app_qualifier = "beacon_app"

/// The client app module: the app's client-visible source, written to
/// `src/app.gleam` of the client project.
pub const app_module = "app"

const handler_module = "handler"

pub const header = [
  "AUTO-GENERATED by beacon/build — do not edit manually.",
  "The client bundle's interface to the Beacon client runtime.",
]

/// Generate the entry module. `client_update` is True when the client app
/// module has an `update` the browser runs.
pub fn generate(
  analysis: Analysis,
  client_update: Bool,
) -> Result(String, String) {
  let codecs = codec_gen.Codecs(type_defs: analysis.type_defs, app_qualifier:)
  use model <- result.try(codec_gen.record(
    codecs,
    analysis.model_module,
    analysis.model_type_name,
  ))
  use local <- result.try(case analysis.has_local {
    True ->
      codec_gen.record(codecs, analysis.local_module, analysis.local_type_name)
      |> result.map(Some)
    False -> Ok(None)
  })
  let types = types(codecs, analysis)
  let primary = messages.primary(analysis)
  let nested = messages.reachable_nested(analysis)

  use encode_model <- result.try(encode_model(codecs, analysis, types))
  use encode_msgs <- result.try(
    list.try_map(
      [
        #("encode_msg", True, primary),
        ..list.map(nested, fn(m) { #(nested_encoder_name(m.module), False, m) })
      ],
      fn(entry) { msg_encoder(codecs, analysis, entry.0, entry.1, entry.2) },
    ),
  )
  use decode_local <- result.try(case local {
    None -> Ok([])
    Some(#(constructor, fields)) ->
      decode_function(
        codecs,
        "decode_local",
        types.local,
        analysis.local_module,
        constructor,
        fields,
        "Failed to decode local",
      )
      |> result.map(fn(definition) { [definition] })
  })
  use decode_model <- result.try(decode_function(
    codecs,
    "decode_model",
    types.model,
    analysis.model_module,
    model.0,
    model.1,
    "Failed to decode model",
  ))
  let update = case client_update {
    True -> [update(types), msg_affects_model(codecs, analysis, types)]
    False -> []
  }

  let msg_arg_roots =
    list.flat_map([primary, ..nested], fn(m) {
      list.flat_map(m.allowed, fn(variant) {
        list.filter_map(variant.fields, fn(f) {
          case messages.nested_module(analysis, f.field_type) {
            Ok(_) -> Error(Nil)
            Error(Nil) -> Ok(f.field_type)
          }
        })
      })
    })
  let state_roots =
    list.append(
      field_types(analysis.model_fields),
      field_types(analysis.local_fields),
    )
  use helpers <- result.try(codec_gen.helpers(
    codecs,
    list.append(state_roots, msg_arg_roots),
    state_roots,
  ))

  let definitions =
    list.flatten([
      [
        init_local(analysis, types),
        start_render(),
        finish_render(types),
        resolve_handler(types),
        view_to_html(types),
        decode_model,
      ],
      decode_local,
      [encode_model],
      encode_msgs,
      update,
      helpers,
    ])
  let imports =
    list.flatten([
      codec_gen.std_imports(),
      [
        Import("beacon_client/handler", None),
        codec_gen.module_import(app_module, app_qualifier),
      ],
      list.map(list.unique(analysis.imported_modules), fn(m) {
        codec_gen.module_import(m.module_path, m.alias)
      }),
    ])
  case gleam_code.render(Module(docs: header, imports:, definitions:)) {
    Ok(source) -> {
      log.debug("beacon.build.client_entry", "Generated client entry module")
      Ok(source)
    }
    Error(reason) -> {
      let message = "Cannot generate the client entry module: " <> reason
      log.error("beacon.build.client_entry", message)
      Error(message)
    }
  }
}

type Types {
  Types(model: TypeExpr, local: TypeExpr, msg: TypeExpr, registry: TypeExpr)
}

fn types(codecs: Codecs, analysis: Analysis) -> Types {
  let msg =
    codec_gen.named_type(codecs, analysis.msg_module, analysis.msg_type_name)
  Types(
    model: codec_gen.named_type(
      codecs,
      analysis.model_module,
      analysis.model_type_name,
    ),
    local: case analysis.has_local {
      True ->
        codec_gen.named_type(
          codecs,
          analysis.local_module,
          analysis.local_type_name,
        )
      False -> codec_gen.nil_type()
    },
    msg:,
    registry: TNamed(Some(handler_module), "HandlerRegistry", [msg]),
  )
}

fn field_types(fields: List(TypeField)) -> List(FieldType) {
  list.map(fields, fn(f) { f.field_type })
}

fn app_call(name: String, args: List(Expr)) -> Expr {
  Call(Ref(Some(app_qualifier), name), list.map(args, Arg))
}

fn handler_call(name: String, args: List(Expr)) -> Expr {
  Call(Ref(Some(handler_module), name), list.map(args, Arg))
}

fn init_local(analysis: Analysis, types: Types) -> Definition {
  case analysis.has_local {
    True ->
      Function(
        "init_local",
        True,
        ["The first Local state for a Model."],
        [Param("model", types.model)],
        types.local,
        [ExprStmt(app_call("init_local", [Var("model")]))],
      )
    False ->
      Function(
        "init_local",
        True,
        ["The app has no Local state."],
        [Param("_model", types.model)],
        codec_gen.nil_type(),
        [ExprStmt(codec_gen.nil())],
      )
  }
}

fn start_render() -> Definition {
  Function("start_render", True, [], [], codec_gen.nil_type(), [
    ExprStmt(handler_call("start_render", [])),
  ])
}

fn finish_render(types: Types) -> Definition {
  Function("finish_render", True, [], [], types.registry, [
    ExprStmt(handler_call("finish_render", [])),
  ])
}

fn resolve_handler(types: Types) -> Definition {
  Function(
    "resolve_handler",
    True,
    [],
    [
      Param("registry", types.registry),
      Param("handler_id", codec_gen.string_type()),
      Param("data", codec_gen.string_type()),
    ],
    codec_gen.result_type(types.msg),
    [
      ExprStmt(
        handler_call("resolve", [
          Var("registry"),
          Var("handler_id"),
          Var("data"),
        ]),
      ),
    ],
  )
}

fn view_to_html(types: Types) -> Definition {
  Function(
    "view_to_html",
    True,
    [],
    [Param("model", types.model), Param("local", types.local)],
    codec_gen.string_type(),
    [
      ExprStmt(Pipe(
        app_call("view", [Var("model"), Var("local")]),
        Ref(Some(codec_gen.element), "to_string"),
      )),
    ],
  )
}

/// `name(json_str) -> Result(T, String)` decoding one record from the
/// `model_sync` JSON object. Keys the record does not have are ignored, so
/// Model and Local decode from the same payload.
fn decode_function(
  codecs: Codecs,
  name: String,
  return: TypeExpr,
  module: String,
  constructor: String,
  fields: List(#(String, FieldType)),
  failure: String,
) -> Result(Definition, String) {
  use body <- result.map(codec_gen.record_decoder_body(
    codecs,
    module,
    constructor,
    fields,
  ))
  Function(
    name,
    True,
    [],
    [Param("json_str", codec_gen.string_type())],
    codec_gen.result_type(return),
    [
      Let(PVar("beacon_decoder"), Block(body)),
      ExprStmt(
        codec_gen.parse_json(
          Var("json_str"),
          Var("beacon_decoder"),
          #("beacon_value", codec_gen.ok(Var("beacon_value"))),
          #(codec_gen.error_pattern(), codec_gen.error(Str(failure))),
        ),
      ),
    ],
  )
}

/// Model and Local fields in the order the server's `encode_model` writes
/// them. Computed fields exist only on the server.
fn encode_model(
  codecs: Codecs,
  analysis: Analysis,
  types: Types,
) -> Result(Definition, String) {
  use model_entries <- result.try(entries(
    codecs,
    analysis.model_fields,
    Var("model"),
  ))
  use local_entries <- result.map(entries(
    codecs,
    analysis.local_fields,
    Var("local"),
  ))
  let model_param = case model_entries {
    [] -> Param("_model", types.model)
    _ -> Param("model", types.model)
  }
  let local_param = case local_entries {
    [] -> Param("_local", types.local)
    _ -> Param("local", types.local)
  }
  Function(
    "encode_model",
    True,
    ["Encode Model and Local fields to JSON for patch diffing."],
    [model_param, local_param],
    codec_gen.string_type(),
    [
      ExprStmt(
        codec_gen.json_to_string(
          codec_gen.json_object(list.append(model_entries, local_entries)),
        ),
      ),
    ],
  )
}

fn entries(
  codecs: Codecs,
  fields: List(TypeField),
  container: Expr,
) -> Result(List(#(String, Expr)), String) {
  list.try_map(fields, fn(f) {
    use encoded <- result.map(codec_gen.encode(
      codecs,
      f.field_type,
      FieldAccess(container, f.name),
    ))
    #(f.name, encoded)
  })
}

fn nested_encoder_name(module: String) -> String {
  "client_encode_msg_" <> module
}

/// Encode a Msg to the `{"tag": .., "argN": ..}` JSON string the server
/// decodes. The match is exhaustive. A variant the browser may not send
/// encodes as its bare tag, which the server rejects by name.
fn msg_encoder(
  codecs: Codecs,
  analysis: Analysis,
  name: String,
  public: Bool,
  msg_type: MsgType,
) -> Result(Definition, String) {
  let q = codec_gen.qualifier(codecs, msg_type.module)
  use clauses <- result.map(
    list.try_map(msg_type.all, fn(variant) {
      case messages.is_allowed(msg_type, variant) {
        True -> allowed_clause(codecs, analysis, q, variant)
        False ->
          Ok(Clause(
            [any_args_pattern(q, variant)],
            codec_gen.json_object([
              #("tag", codec_gen.json_call("string", [Str(variant.name)])),
            ]),
          ))
      }
    }),
  )
  Function(
    name,
    public,
    [],
    [
      Param(
        "msg",
        codec_gen.named_type(codecs, msg_type.module, msg_type.type_name),
      ),
    ],
    codec_gen.string_type(),
    [ExprStmt(codec_gen.json_to_string(Case([Var("msg")], clauses)))],
  )
}

fn allowed_clause(
  codecs: Codecs,
  analysis: Analysis,
  q: String,
  variant: MsgVariant,
) -> Result(gleam_code.Clause, String) {
  let indexed = list.index_map(variant.fields, fn(f, index) { #(index, f) })
  use args <- result.map(
    list.try_map(indexed, fn(entry) {
      let #(index, f) = entry
      let value = Var(arg_var(index))
      let encoded = case messages.nested_module(analysis, f.field_type) {
        Ok(module) ->
          Ok(
            codec_gen.json_call("string", [
              Call(Ref(None, nested_encoder_name(module)), [Arg(value)]),
            ]),
          )
        Error(Nil) -> codec_gen.encode(codecs, f.field_type, value)
      }
      use encoded <- result.map(encoded)
      #(messages.arg_key(index), encoded)
    }),
  )
  let pattern = case indexed {
    [] -> PCtor(Some(q), variant.name, [], False)
    _ ->
      PCtor(
        Some(q),
        variant.name,
        list.map(indexed, fn(entry) { PVar(arg_var(entry.0)) }),
        False,
      )
  }
  Clause(
    [pattern],
    codec_gen.json_object([
      #("tag", codec_gen.json_call("string", [Str(variant.name)])),
      ..args
    ]),
  )
}

/// `q.Name(..)`, or `q.Name` for a variant without fields.
fn any_args_pattern(q: String, variant: MsgVariant) -> gleam_code.Pattern {
  case variant.fields {
    [] -> PCtor(Some(q), variant.name, [], False)
    _ -> PCtor(Some(q), variant.name, [], True)
  }
}

fn arg_var(index: Int) -> String {
  "beacon_a" <> int.to_string(index)
}

/// The browser-side update: the app's update with no Server state.
fn update(types: Types) -> Definition {
  Function(
    "update",
    True,
    ["Run the app's update in the browser. The app has no Server state."],
    [
      Param("model", types.model),
      Param("local", types.local),
      Param("msg", types.msg),
    ],
    TTuple([types.model, types.local]),
    [
      Let(
        PTuple([PVar("new_model"), PVar("new_local"), PDiscard("server")]),
        app_call("update", [
          Var("model"),
          Var("local"),
          codec_gen.nil(),
          Var("msg"),
        ]),
      ),
      ExprStmt(TupleExpr([Var("new_model"), Var("new_local")])),
    ],
  )
}

/// True when a Msg changes the Model, so the server must confirm it. The
/// match is exhaustive: a variant the analyzer did not classify is a build
/// error, never a default.
fn msg_affects_model(
  codecs: Codecs,
  analysis: Analysis,
  types: Types,
) -> Definition {
  let q = codec_gen.qualifier(codecs, analysis.msg_module)
  Function(
    "msg_affects_model",
    True,
    [],
    [Param("msg", types.msg)],
    codec_gen.bool_type(),
    [
      ExprStmt(Case(
        [Var("msg")],
        list.map(analysis.msg_type_variants, fn(variant) {
          Clause([any_args_pattern(q, variant)], case variant.affects_model {
            True -> codec_gen.true_()
            False -> codec_gen.false_()
          })
        }),
      )),
    ],
  )
}
