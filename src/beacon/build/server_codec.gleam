/// Generates `beacon_codec.gleam`, the server half of the wire contract.
///
/// The runtime (`beacon_runtime_ffi`) calls these exports by name:
///
/// - `encode_model(#(Model, Local, Server)) -> String`: Model fields, Local
///   fields and computed fields as one JSON object, sent as `model_sync`.
/// - `render_model(#(Model, Local, Server)) -> String`: the view as HTML.
/// - `decode_model(String) -> Result(#(Model, Local, Server), String)`: the
///   inverse of `encode_model` for Model and Local; unsupported when the app
///   has private Server state, which can never come from the client.
/// - `decode_event(name, handler_id, data, target_path)`: the Msg inside the
///   `__beacon_msg` envelope the client sends. Only variants the browser may
///   send decode; every other tag is rejected.
/// - `substate_names`, `encode_substate_<field>` and `encode_flat_fields`,
///   when the Model has record fields the runtime diffs separately.
import beacon/build/analyzer.{type Analysis, type MsgVariant, type TypeField}
import beacon/build/codec_gen.{type Codecs}
import beacon/build/field_type.{type FieldType}
import beacon/build/gleam_code.{
  type Definition, type Expr, type TypeExpr, Arg, BinOp, Block, Call, Case,
  Clause, Concat, Ctor, ExprStmt, FieldAccess, Function, Let, ListExpr, Module,
  PCtor, PDiscard, PString, PTuple, PVar, Param, Pipe, Ref, Str, TNamed, TTuple,
  TupleExpr, TupleIndex, Use, Var,
}
import beacon/build/messages.{type MsgType}
import beacon/log
import gleam/int
import gleam/list
import gleam/option.{None, Some}
import gleam/result
import gleam/string

/// The alias the codec imports the app module under.
const app_qualifier = "beacon_app"

pub const header = [
  "AUTO-GENERATED by beacon/build — do not edit manually.",
  "Re-run `gleam run -m beacon/build` to regenerate.",
]

/// Generate the codec module for the app module at `app_module_path` (its
/// import path, such as `counter` or `app/main`).
pub fn generate(
  analysis: Analysis,
  app_module_path: String,
) -> Result(String, String) {
  let codecs = codec_gen.Codecs(type_defs: analysis.type_defs, app_qualifier:)
  use Nil <- result.try(check_unique_keys(analysis))
  use model <- result.try(codec_gen.record(
    codecs,
    analysis.model_module,
    analysis.model_type_name,
  ))
  use local <- result.try(case analysis.has_local {
    True ->
      codec_gen.record(codecs, analysis.local_module, analysis.local_type_name)
      |> result.map(Some)
    False -> Ok(None)
  })
  let state_type = state_type(codecs, analysis)
  let primary = messages.primary(analysis)
  let nested = messages.reachable_nested(analysis)

  use encode_model <- result.try(encode_model(codecs, analysis, state_type))
  use decode_model <- result.try(decode_model(
    codecs,
    analysis,
    state_type,
    model,
    local,
  ))
  use msg_decoders <- result.try(
    list.try_map(
      [
        #("decode_msg", primary),
        ..list.map(nested, fn(m) { #(nested_decoder_name(m.module), m) })
      ],
      fn(entry) { msg_decoder(codecs, analysis, entry.0, entry.1) },
    ),
  )
  use substates <- result.try(substate_functions(codecs, analysis, state_type))

  let encode_roots =
    list.flatten([
      field_types(analysis.model_fields),
      field_types(analysis.local_fields),
      list.map(analysis.computed_fields, fn(c) { c.field_type }),
    ])
  let decode_model_roots = case analysis.has_server {
    True -> []
    False ->
      list.append(
        field_types(analysis.model_fields),
        field_types(analysis.local_fields),
      )
  }
  let decode_msg_roots =
    list.flat_map([primary, ..nested], fn(m) {
      list.flat_map(m.allowed, fn(variant) {
        list.filter_map(variant.fields, fn(f) {
          case messages.nested_module(analysis, f.field_type) {
            Ok(_) -> Error(Nil)
            Error(Nil) -> Ok(f.field_type)
          }
        })
      })
    })
  use helpers <- result.try(codec_gen.helpers(
    codecs,
    encode_roots,
    list.append(decode_model_roots, decode_msg_roots),
  ))

  let definitions =
    list.flatten([
      [
        encode_model,
        render_model(state_type),
        decode_model,
        decode_event(codecs, primary),
      ],
      substates,
      msg_decoders,
      helpers,
    ])
  let imports =
    list.flatten([
      codec_gen.std_imports(),
      [codec_gen.module_import(app_module_path, app_qualifier)],
      list.map(list.unique(analysis.imported_modules), fn(m) {
        codec_gen.module_import(m.module_path, m.alias)
      }),
    ])
  let rendered = gleam_code.render(Module(docs: header, imports:, definitions:))
  case rendered {
    Ok(source) -> {
      log.debug(
        "beacon.build.server_codec",
        "Generated server codec for " <> app_module_path,
      )
      Ok(source)
    }
    Error(reason) -> {
      let message = "Cannot generate the server codec: " <> reason
      log.error("beacon.build.server_codec", message)
      Error(message)
    }
  }
}

fn field_types(fields: List(TypeField)) -> List(FieldType) {
  list.map(fields, fn(f) { f.field_type })
}

/// `#(Model, Local, Server)`, with `Nil` for the parts the app does not have.
fn state_type(codecs: Codecs, analysis: Analysis) -> TypeExpr {
  let model =
    codec_gen.named_type(
      codecs,
      analysis.model_module,
      analysis.model_type_name,
    )
  let local = case analysis.has_local {
    True ->
      codec_gen.named_type(
        codecs,
        analysis.local_module,
        analysis.local_type_name,
      )
    False -> codec_gen.nil_type()
  }
  let server = case analysis.has_server {
    True ->
      codec_gen.named_type(
        codecs,
        analysis.server_module,
        analysis.server_type_name,
      )
    False -> codec_gen.nil_type()
  }
  TTuple([model, local, server])
}

/// Model, Local and computed fields share one JSON object, so their names
/// must be distinct.
fn check_unique_keys(analysis: Analysis) -> Result(Nil, String) {
  let keys =
    list.flatten([
      list.map(analysis.model_fields, fn(f) { #(f.name, "Model field") }),
      list.map(analysis.local_fields, fn(f) { #(f.name, "Local field") }),
      list.map(analysis.computed_fields, fn(c) { #(c.name, "computed field") }),
    ])
  let clashes =
    list.filter(keys, fn(key) {
      list.count(keys, fn(other) { other.0 == key.0 }) > 1
    })
  case clashes {
    [] -> Ok(Nil)
    _ ->
      Error(
        "These names are used by more than one of Model, Local and computed fields, so they would collide in the synced JSON: "
        <> clashes
        |> list.map(fn(key) { key.1 <> " `" <> key.0 <> "`" })
        |> string.join(", ")
        <> ". Rename them so every name is unique.",
      )
  }
}

fn state_part(index: Int) -> Expr {
  TupleIndex(Var("state"), index)
}

fn state_param(state_type: TypeExpr, used: Bool) -> gleam_code.Param {
  case used {
    True -> Param("state", state_type)
    False -> Param("_state", state_type)
  }
}

fn encode_entries(
  codecs: Codecs,
  fields: List(TypeField),
  container: Expr,
) -> Result(List(#(String, Expr)), String) {
  list.try_map(fields, fn(f) {
    use encoded <- result.map(codec_gen.encode(
      codecs,
      f.field_type,
      FieldAccess(container, f.name),
    ))
    #(f.name, encoded)
  })
}

fn encode_model(
  codecs: Codecs,
  analysis: Analysis,
  state_type: TypeExpr,
) -> Result(Definition, String) {
  use model_entries <- result.try(encode_entries(
    codecs,
    analysis.model_fields,
    state_part(0),
  ))
  use local_entries <- result.try(encode_entries(
    codecs,
    analysis.local_fields,
    state_part(1),
  ))
  use computed_entries <- result.map(
    list.try_map(analysis.computed_fields, fn(c) {
      use encoded <- result.map(codec_gen.encode(
        codecs,
        c.field_type,
        Call(Ref(Some(app_qualifier), c.name), [Arg(state_part(0))]),
      ))
      #(c.name, encoded)
    }),
  )
  let entries = list.flatten([model_entries, local_entries, computed_entries])
  Function(
    "encode_model",
    True,
    ["Encode Model, Local and computed fields to JSON for model_sync."],
    [state_param(state_type, entries != [])],
    codec_gen.string_type(),
    [ExprStmt(codec_gen.json_to_string(codec_gen.json_object(entries)))],
  )
}

fn render_model(state_type: TypeExpr) -> Definition {
  Function(
    "render_model",
    True,
    ["Render the view to HTML, as SSR does."],
    [Param("state", state_type)],
    codec_gen.string_type(),
    [
      ExprStmt(Pipe(
        Call(Ref(Some(app_qualifier), "view"), [
          Arg(state_part(0)),
          Arg(state_part(1)),
        ]),
        Ref(Some(codec_gen.element), "to_string"),
      )),
    ],
  )
}

fn decode_model(
  codecs: Codecs,
  analysis: Analysis,
  state_type: TypeExpr,
  model: #(String, List(#(String, FieldType))),
  local: option.Option(#(String, List(#(String, FieldType)))),
) -> Result(Definition, String) {
  let return = codec_gen.result_type(state_type)
  case analysis.has_server {
    True ->
      Ok(
        Function(
          "decode_model",
          True,
          [
            "Server state never comes from the client, so the full state cannot be decoded.",
          ],
          [Param("_json_str", codec_gen.string_type())],
          return,
          [
            ExprStmt(
              codec_gen.error(Str(
                "decode_model not supported when Server state is present",
              )),
            ),
          ],
        ),
      )
    False -> {
      let #(model_ctor, model_fields) = model
      use model_uses <- result.try(codec_gen.field_decoders(
        codecs,
        model_fields,
      ))
      use #(local_uses, local_value) <- result.try(case local {
        None -> Ok(#([], codec_gen.nil()))
        Some(#(local_ctor, local_fields)) -> {
          use uses <- result.map(codec_gen.field_decoders(codecs, local_fields))
          #(
            uses,
            codec_gen.construct(
              codecs,
              analysis.local_module,
              local_ctor,
              local_fields,
            ),
          )
        }
      })
      let model_value =
        codec_gen.construct(
          codecs,
          analysis.model_module,
          model_ctor,
          model_fields,
        )
      let decoder =
        Block(
          list.flatten([
            model_uses,
            local_uses,
            [
              ExprStmt(
                codec_gen.decode_success(
                  TupleExpr([model_value, local_value, codec_gen.nil()]),
                ),
              ),
            ],
          ]),
        )
      Ok(
        Function(
          "decode_model",
          True,
          ["Decode the JSON `encode_model` produces back into the state."],
          [Param("json_str", codec_gen.string_type())],
          return,
          [
            Let(PVar("beacon_decoder"), decoder),
            ExprStmt(codec_gen.parse_json(
              Var("json_str"),
              Var("beacon_decoder"),
              #("beacon_state", codec_gen.ok(Var("beacon_state"))),
              inspect_error("Failed to decode model+local+server: "),
            )),
          ],
        ),
      )
    }
  }
}

/// `Error(prefix <> beacon_string.inspect(beacon_error))` for a parse failure.
fn inspect_error(prefix: String) -> #(gleam_code.Pattern, Expr) {
  #(
    codec_gen.error_pattern_named("beacon_error"),
    codec_gen.error(BinOp(
      Concat,
      Str(prefix),
      Call(Ref(Some(codec_gen.string_module), "inspect"), [
        Arg(Var("beacon_error")),
      ]),
    )),
  )
}

fn msg_type_expr(codecs: Codecs, msg_type: MsgType) -> TypeExpr {
  codec_gen.named_type(codecs, msg_type.module, msg_type.type_name)
}

fn decode_event(codecs: Codecs, primary: MsgType) -> Definition {
  let envelope =
    Block([
      codec_gen.decode_field(
        "beacon_msg_json",
        "__beacon_msg",
        Ref(Some(codec_gen.decode), "string"),
      ),
      ExprStmt(codec_gen.decode_success(Var("beacon_msg_json"))),
    ])
  Function(
    "decode_event",
    True,
    [
      "Decode the Msg a client event carries in its `__beacon_msg` envelope.",
      "Live event decoding never renders the view or reads the handler registry.",
    ],
    [
      Param("_name", codec_gen.string_type()),
      Param("_handler_id", codec_gen.string_type()),
      Param("data", codec_gen.string_type()),
      Param("_target_path", codec_gen.string_type()),
    ],
    codec_gen.result_type(msg_type_expr(codecs, primary)),
    [
      Let(PVar("beacon_envelope"), envelope),
      ExprStmt(
        Case(
          [codec_gen.json_call("parse", [Var("data"), Var("beacon_envelope")])],
          [
            Clause(
              [codec_gen.ok_pattern("beacon_msg_json")],
              Call(Ref(None, "decode_msg"), [Arg(Var("beacon_msg_json"))]),
            ),
            Clause(
              [codec_gen.error_pattern()],
              codec_gen.error(Str(
                "Client event missing generated Beacon message envelope",
              )),
            ),
          ],
        ),
      ),
    ],
  )
}

fn nested_decoder_name(module: String) -> String {
  "decode_msg_" <> module
}

/// A private decoder from a `{"tag": .., "arg0": ..}` JSON string to a Msg.
/// Variants the browser may not send are rejected by name.
fn msg_decoder(
  codecs: Codecs,
  analysis: Analysis,
  name: String,
  msg_type: MsgType,
) -> Result(Definition, String) {
  let q = codec_gen.qualifier(codecs, msg_type.module)
  use arms <- result.map(
    list.try_map(msg_type.all, fn(variant) {
      case messages.is_allowed(msg_type, variant) {
        True -> allowed_arm(codecs, analysis, q, variant)
        False ->
          Ok(Clause(
            [PString(variant.name)],
            codec_gen.error(Str(
              "Msg variant "
              <> variant.name
              <> " is not in the ClientMsg allowlist",
            )),
          ))
      }
    }),
  )
  let unknown =
    Clause(
      [PDiscard("")],
      codec_gen.error(BinOp(
        Concat,
        Str("Unknown generated Beacon message tag "),
        Var("beacon_tag"),
      )),
    )
  let tag_decoder =
    Block([
      codec_gen.decode_field(
        "beacon_tag",
        "tag",
        Ref(Some(codec_gen.decode), "string"),
      ),
      ExprStmt(codec_gen.decode_success(Var("beacon_tag"))),
    ])
  Function(
    name,
    False,
    [],
    [Param("json_str", codec_gen.string_type())],
    codec_gen.result_type(msg_type_expr(codecs, msg_type)),
    [
      Let(PVar("beacon_tag_decoder"), tag_decoder),
      ExprStmt(
        Case(
          [
            codec_gen.json_call("parse", [
              Var("json_str"),
              Var("beacon_tag_decoder"),
            ]),
          ],
          [
            Clause(
              [codec_gen.ok_pattern("beacon_tag")],
              Case([Var("beacon_tag")], list.append(arms, [unknown])),
            ),
            Clause(
              [codec_gen.error_pattern()],
              codec_gen.error(Str(
                "Generated Beacon message payload missing tag",
              )),
            ),
          ],
        ),
      ),
    ],
  )
}

fn allowed_arm(
  codecs: Codecs,
  analysis: Analysis,
  q: String,
  variant: MsgVariant,
) -> Result(gleam_code.Clause, String) {
  let ctor = Ctor(Some(q), variant.name)
  case variant.fields {
    [] -> Ok(Clause([PString(variant.name)], codec_gen.ok(ctor)))
    fields -> {
      let indexed = list.index_map(fields, fn(f, index) { #(index, f) })
      use uses <- result.map(
        list.try_map(indexed, fn(entry) {
          let #(index, f) = entry
          let decoder = case messages.nested_module(analysis, f.field_type) {
            Ok(_) -> Ok(Ref(Some(codec_gen.decode), "string"))
            Error(Nil) -> codec_gen.decoder(codecs, f.field_type)
          }
          use decoder <- result.map(decoder)
          codec_gen.decode_field(
            arg_var(index),
            messages.arg_key(index),
            decoder,
          )
        }),
      )
      let raw_values = list.map(indexed, fn(entry) { Var(arg_var(entry.0)) })
      let payload_decoder =
        Block(
          list.append(uses, [
            ExprStmt(codec_gen.decode_success(TupleExpr(raw_values))),
          ]),
        )
      // Nested Msg arguments arrive as JSON strings and decode in a second step.
      let nested_steps =
        list.filter_map(indexed, fn(entry) {
          let #(index, f) = entry
          case messages.nested_module(analysis, f.field_type) {
            Ok(module) ->
              Ok(Use(
                [nested_var(index)],
                Call(Ref(Some(codec_gen.result_module), "try"), [
                  Arg(
                    Call(Ref(None, nested_decoder_name(module)), [
                      Arg(Var(arg_var(index))),
                    ]),
                  ),
                ]),
              ))
            Error(Nil) -> Error(Nil)
          }
        })
      let args =
        list.map(indexed, fn(entry) {
          let #(index, f) = entry
          case messages.nested_module(analysis, f.field_type) {
            Ok(_) -> Arg(Var(nested_var(index)))
            Error(Nil) -> Arg(Var(arg_var(index)))
          }
        })
      let built = codec_gen.ok(Call(ctor, args))
      let on_ok = case nested_steps {
        [] -> built
        _ -> Block(list.append(nested_steps, [ExprStmt(built)]))
      }
      Clause(
        [PString(variant.name)],
        Block([
          Let(PVar("beacon_decoder"), payload_decoder),
          ExprStmt(
            Case(
              [
                codec_gen.json_call("parse", [
                  Var("json_str"),
                  Var("beacon_decoder"),
                ]),
              ],
              [
                Clause(
                  [
                    PCtor(
                      None,
                      "Ok",
                      [
                        PTuple(
                          list.map(indexed, fn(entry) { PVar(arg_var(entry.0)) }),
                        ),
                      ],
                      False,
                    ),
                  ],
                  on_ok,
                ),
                Clause(
                  [codec_gen.error_pattern()],
                  codec_gen.error(Str(
                    "Generated Beacon message payload did not match tag "
                    <> variant.name,
                  )),
                ),
              ],
            ),
          ),
        ]),
      )
    }
  }
}

fn arg_var(index: Int) -> String {
  "beacon_a" <> int.to_string(index)
}

fn nested_var(index: Int) -> String {
  "beacon_m" <> int.to_string(index)
}

/// Per-substate encoders, the substate names, and an encoder for the rest of
/// the Model. Generated only when the Model has substates.
fn substate_functions(
  codecs: Codecs,
  analysis: Analysis,
  state_type: TypeExpr,
) -> Result(List(Definition), String) {
  case analysis.substates {
    [] -> Ok([])
    substates -> {
      let names = list.map(substates, fn(s) { s.field_name })
      use encoders <- result.try(
        list.try_map(substates, fn(s) {
          use field <- result.try(model_field(analysis, s.field_name))
          use encoded <- result.map(codec_gen.encode(
            codecs,
            field.field_type,
            FieldAccess(state_part(0), field.name),
          ))
          Function(
            "encode_substate_" <> s.field_name,
            True,
            [],
            [Param("state", state_type)],
            codec_gen.string_type(),
            [ExprStmt(codec_gen.json_to_string(encoded))],
          )
        }),
      )
      let flat =
        list.filter(analysis.model_fields, fn(f) {
          !list.contains(names, f.name)
        })
      use flat_entries <- result.map(encode_entries(codecs, flat, state_part(0)))
      list.append(encoders, [
        Function(
          "substate_names",
          True,
          [],
          [],
          TNamed(None, "List", [codec_gen.string_type()]),
          [ExprStmt(ListExpr(list.map(names, Str)))],
        ),
        Function(
          "encode_flat_fields",
          True,
          ["Encode the Model fields that are not substates."],
          [state_param(state_type, flat_entries != [])],
          codec_gen.string_type(),
          [
            ExprStmt(
              codec_gen.json_to_string(codec_gen.json_object(flat_entries)),
            ),
          ],
        ),
      ])
    }
  }
}

fn model_field(analysis: Analysis, name: String) -> Result(TypeField, String) {
  list.find(analysis.model_fields, fn(f) { f.name == name })
  |> result.replace_error(
    "Invariant violated: substate `" <> name <> "` is not a Model field",
  )
}
