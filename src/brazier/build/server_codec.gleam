/// Generates `brazier_codec.gleam`, the server half of the wire contract.
///
/// The runtime (`brazier_runtime_ffi`) calls these exports by name:
///
/// - `encode_model(Model) -> String`: the synced Model as JSON, sent as
///   `model_sync`.
/// - `decode_model(String) -> Result(Model, String)`: the inverse, used for
///   state recovery.
/// - `decode_event(name, handler_id, data, target_path)`: the Msg in the
///   `{"__brazier_msg": ..}` envelope the client sends. Only the constructors
///   client code builds decode (see `brazier/build/codec_gen`); every other
///   tag is rejected.
/// - `stream_names() -> List(String)`: the streams the app declares.
import brazier/build/analyzer.{type Analysis}
import brazier/build/codec_gen
import brazier/build/field_type
import brazier/build/gleam_code.{
  Arg, Call, Case, Clause, ExprStmt, Function, ListExpr, Module, Param, Ref, Str,
  Var,
}
import brazier/log
import gleam/dict
import gleam/list
import gleam/option.{Some}
import gleam/result
import gleam/string

pub const header = [
  "AUTO-GENERATED by brazier/build — do not edit manually.",
  "Re-run `gleam run -m brazier/build` to regenerate.",
]

/// The envelope key the client puts the encoded Msg under.
pub const msg_key = "__brazier_msg"

/// Generate the codec module.
pub fn generate(analysis: Analysis) -> Result(String, String) {
  let codecs = analysis.codecs
  let msg = field_type.NamedType(analysis.msg.0, analysis.msg.1)
  use model_type <- result.try(codec_gen.type_expr(analysis.model))
  use msg_type <- result.try(codec_gen.type_expr(msg))
  use encode <- result.try(codec_gen.encode(
    codecs,
    analysis.model,
    Var("model"),
  ))
  use model_decoder <- result.try(codec_gen.decoder(codecs, analysis.model))
  use msg_decoder <- result.try(codec_gen.decoder(codecs, msg))
  use helpers <- result.try(
    codec_gen.helpers(codecs, [analysis.model], [analysis.model, msg]),
  )
  let definitions = [
    Function(
      "encode_model",
      True,
      ["The synced Model as JSON."],
      [Param("model", model_type)],
      codec_gen.string_type(),
      [ExprStmt(codec_gen.json_to_string(encode))],
    ),
    Function(
      "decode_model",
      True,
      ["The Model `encode_model` wrote."],
      [Param("data", codec_gen.string_type())],
      codec_gen.result_type(model_type),
      [ExprStmt(parse("data", model_decoder, "Cannot decode the model: "))],
    ),
    Function(
      "decode_event",
      True,
      [
        "The Msg in a client event's `" <> msg_key <> "` envelope.",
        "Only the constructors client code builds are accepted.",
      ],
      [
        Param("_name", codec_gen.string_type()),
        Param("_handler_id", codec_gen.string_type()),
        Param("data", codec_gen.string_type()),
        Param("_target_path", codec_gen.string_type()),
      ],
      codec_gen.result_type(msg_type),
      [
        ExprStmt(parse(
          "data",
          codec_gen.decode_call("at", [ListExpr([Str(msg_key)]), msg_decoder]),
          "Cannot decode the client message: ",
        )),
      ],
    ),
    Function(
      "stream_names",
      True,
      [
        "The streams the app declares, sorted. The runtime refuses an op on",
        "any other name (docs/design/STREAMS.md 7.5).",
      ],
      [],
      gleam_code.TNamed(option.None, "List", [codec_gen.string_type()]),
      [ExprStmt(ListExpr(list.map(stream_names(analysis), Str)))],
    ),
    ..helpers
  ]
  let imports =
    list.append(
      codec_gen.std_imports(),
      dict.keys(codecs.type_defs)
        |> list.map(fn(key) { key.0 })
        |> list.unique
        |> list.sort(string.compare)
        |> list.map(codec_gen.module_import),
    )
  use source <- result.map(
    gleam_code.render(Module(docs: header, imports:, definitions:)),
  )
  log.debug(
    "brazier.build.server_codec",
    "Generated the server codec for " <> analysis.app_module,
  )
  source
}

/// The declared stream names, sorted, each once. The analyzer refuses a
/// name declared twice, so `unique` only guards the generated list.
pub fn stream_names(analysis: Analysis) -> List(String) {
  list.map(analysis.streams, fn(decl) { decl.name })
  |> list.unique
  |> list.sort(string.compare)
}

/// `case brazier_json.parse(var, decoder) { Ok(v) -> Ok(v)  Error(e) ->
/// Error(prefix <> inspect(e)) }`
fn parse(
  var: String,
  decoder: gleam_code.Expr,
  prefix: String,
) -> gleam_code.Expr {
  Case(
    [Call(Ref(Some(codec_gen.json), "parse"), [Arg(Var(var)), Arg(decoder)])],
    [
      Clause(
        [codec_gen.ok_pattern("brazier_value")],
        codec_gen.ok(Var("brazier_value")),
      ),
      Clause(
        [codec_gen.error_pattern_named("brazier_error")],
        codec_gen.inspect_error(prefix, "brazier_error"),
      ),
    ],
  )
}
