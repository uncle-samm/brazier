/// Generates `brazier_app_entry.gleam`, the module the client bundle passes
/// to the runtime's `start` (in `brazier_client_ffi.mjs`).
///
/// The client runtime calls these exports by name:
///
/// - `decode_model(data)`: the Model from the parsed `model` value of a
///   `model_sync` frame (a Dynamic; the frame is parsed once).
/// - `init_local(model)`: the first Local state, `Nil` without a layer.
/// - `render(model, local)`: the view as `#(html, handlers, containers)`.
/// - `stream_names()`, and `container_name`, `container_keep`,
///   `container_limit`, `container_item` and `render_item(container, key,
///   item)` for the stream containers of the last render.
/// - `lookup_handler(handlers, event, id)`, `run_handler(handler, event)`,
///   `handler_options(handler)` and `event_names(handlers)`: the handler
///   table of the last render.
/// - `update_local(model, local, msg)`: `#(local, forward)`; without a layer
///   every message is forwarded.
/// - `encode_msg(msg)`: the `{"__brazier_msg": ..}` JSON the server's
///   `decode_event` reads.
/// - `is_simple()`, and for a `simple` app `update(model, msg)`: the
///   update the browser applies before the server confirms it.
/// - `same_model(a, b)`: whether a predicted Model equals a synced one.
import brazier/build/analyzer.{type Analysis}
import brazier/build/app_call
import brazier/build/codec_gen
import brazier/build/field_type
import brazier/build/gleam_code.{
  type Definition, type Expr, Arg, BinOp, Call, Case, Clause, Ctor, ExprStmt,
  FieldAccess, Function, Import, Let, ListExpr, Module, PVar, Param, Ref, Str,
  THole, TNamed, TTuple, TupleExpr, Var,
}
import brazier/build/server_codec
import brazier/log
import gleam/dict
import gleam/list
import gleam/option.{None, Some}
import gleam/result
import gleam/string

/// The module path of the generated entry in the client project.
pub const module_path = "brazier_app_entry"

pub const header = [
  "AUTO-GENERATED by brazier/build — do not edit manually.",
  "The client bundle's interface to the Brazier client runtime.",
]

const element = "brazier_element"

const render_module = "brazier_render"

const local_module = "brazier_local"

/// `gleam/dynamic`, imported with the standard imports of `codec_gen`.
const dynamic_module = codec_gen.dynamic_module

const stream_op_module = "brazier_stream_op"

/// Generate the entry module.
pub fn generate(analysis: Analysis) -> Result(String, String) {
  let codecs = analysis.codecs
  let call = analysis.call
  let msg = field_type.NamedType(analysis.msg.0, analysis.msg.1)
  use model_type <- result.try(codec_gen.type_expr(analysis.model))
  use msg_type <- result.try(codec_gen.type_expr(msg))
  use model_decoded <- result.try(codec_gen.decode_value(
    codecs,
    analysis.model,
    Var("data"),
  ))
  use encode_msg <- result.try(codec_gen.encode(codecs, msg, Var("msg")))
  use helpers <- result.try(codec_gen.helpers(codecs, [msg], [analysis.model]))
  let bool = TNamed(None, "Bool", [])
  let handler_type = TNamed(Some(render_module), "Handler", [msg_type])
  let handlers_type = TNamed(Some(render_module), "Handlers", [msg_type])
  let definitions =
    list.flatten([
      [
        Function(
          "decode_model",
          True,
          [
            "The Model in a `model_sync` frame: its `model` value, already",
            "parsed with the rest of the frame.",
          ],
          [Param("data", TNamed(Some(dynamic_module), "Dynamic", []))],
          codec_gen.result_type(model_type),
          [
            // The error is reported as a list, as `decode.run` reported its
            // errors; the decoders stop at the first.
            Let(PVar("brazier_decoded"), model_decoded),
            ExprStmt(
              Case([Var("brazier_decoded")], [
                Clause(
                  [codec_gen.ok_pattern("brazier_value")],
                  codec_gen.ok(Var("brazier_value")),
                ),
                Clause(
                  [codec_gen.error_pattern_named("brazier_error")],
                  codec_gen.error(BinOp(
                    gleam_code.Concat,
                    Str("Cannot decode the model: "),
                    Call(Ref(Some(codec_gen.string_module), "inspect"), [
                      Arg(ListExpr([Var("brazier_error")])),
                    ]),
                  )),
                ),
              ]),
            ),
          ],
        ),
        init_local(call, model_type),
        render(call, model_type),
        update_local(call, model_type, msg_type),
        Function(
          "encode_msg",
          True,
          ["A message in the envelope the server's `decode_event` reads."],
          [Param("msg", msg_type)],
          codec_gen.string_type(),
          [
            ExprStmt(
              codec_gen.json_to_string(
                codec_gen.json_object([#(server_codec.msg_key, encode_msg)]),
              ),
            ),
          ],
        ),
        Function(
          "same_model",
          True,
          ["Whether a predicted Model equals the synced one."],
          [Param("a", model_type), Param("b", model_type)],
          bool,
          [ExprStmt(BinOp(gleam_code.Equal, Var("a"), Var("b")))],
        ),
        Function(
          "lookup_handler",
          True,
          ["The handler for `event` on the element at position `id`."],
          [
            Param("handlers", handlers_type),
            Param("event", codec_gen.string_type()),
            Param("id", codec_gen.string_type()),
          ],
          TNamed(None, "Result", [handler_type, TNamed(None, "Nil", [])]),
          [
            ExprStmt(
              render_call("lookup", [Var("handlers"), Var("event"), Var("id")]),
            ),
          ],
        ),
        Function(
          "run_handler",
          True,
          ["Run a handler's decoder against the browser's event object."],
          [
            Param("handler", handler_type),
            Param("event", TNamed(Some(dynamic_module), "Dynamic", [])),
          ],
          codec_gen.result_type(msg_type),
          [
            ExprStmt(
              Case([render_call("run", [Var("handler"), Var("event")])], [
                Clause(
                  [codec_gen.ok_pattern("brazier_msg")],
                  codec_gen.ok(Var("brazier_msg")),
                ),
                Clause(
                  [codec_gen.error_pattern_named("brazier_errors")],
                  codec_gen.error(
                    render_call("describe_errors", [
                      Var("brazier_errors"),
                    ]),
                  ),
                ),
              ]),
            ),
          ],
        ),
        Function(
          "handler_options",
          True,
          ["#(prevent_default, stop_propagation, debounce_ms, throttle_ms)"],
          [Param("handler", handler_type)],
          TTuple([bool, bool, int_type(), int_type()]),
          [
            ExprStmt(
              TupleExpr([
                FieldAccess(Var("handler"), "prevent_default"),
                FieldAccess(Var("handler"), "stop_propagation"),
                FieldAccess(Var("handler"), "debounce_ms"),
                FieldAccess(Var("handler"), "throttle_ms"),
              ]),
            ),
          ],
        ),
        Function(
          "event_names",
          True,
          ["The event names the handler table listens for."],
          [Param("handlers", handlers_type)],
          TNamed(None, "List", [codec_gen.string_type()]),
          [ExprStmt(render_call("event_names", [Var("handlers")]))],
        ),
        Function(
          "is_simple",
          True,
          ["True when the browser applies `update` before the server confirms."],
          [],
          bool,
          [
            ExprStmt(
              Ctor(None, case call.kind {
                app_call.Simple -> "True"
                app_call.Application | app_call.FullApplication -> "False"
              }),
            ),
          ],
        ),
      ],
      simple_update(call, model_type, msg_type),
      stream_exports(analysis, msg_type),
      helpers,
    ])
  let user_imports =
    dict.keys(codecs.type_defs)
    |> list.map(fn(key) { key.0 })
    |> list.append(app_modules(call))
    |> list.unique
    |> list.sort(string.compare)
    |> list.map(codec_gen.module_import)
  let imports =
    list.flatten([
      codec_gen.std_imports(),
      [
        Import("brazier/element", Some(element)),
        Import("brazier/internal/render", Some(render_module)),
        Import("brazier/internal/stream_op", Some(stream_op_module)),
        Import("brazier/local", Some(local_module)),
      ],
      user_imports,
    ])
  case gleam_code.render(Module(docs: header, imports:, definitions:)) {
    Ok(source) -> {
      log.debug(
        "brazier.build.client_entry",
        "Generated the client entry for "
          <> analysis.app_module
          <> " ("
          <> app_call.kind_name(call.kind)
          <> ")",
      )
      Ok(source)
    }
    Error(reason) -> {
      let message = "Cannot generate the client entry module: " <> reason
      log.error("brazier.build.client_entry", message)
      Error(message)
    }
  }
}

fn int_type() -> gleam_code.TypeExpr {
  TNamed(None, "Int", [])
}

fn render_call(name: String, args: List(Expr)) -> Expr {
  Call(Ref(Some(render_module), name), list.map(args, Arg))
}

fn app_ref(ref: app_call.FunctionRef) -> Expr {
  Ref(Some(codec_gen.module_alias(ref.module)), ref.name)
}

fn call_ref(ref: app_call.FunctionRef, args: List(Expr)) -> Expr {
  Call(app_ref(ref), list.map(args, Arg))
}

/// The modules the entry calls functions of.
fn app_modules(call: app_call.AppCall) -> List(String) {
  let local = case call.local {
    app_call.NoLocal -> []
    app_call.LocalLayer(init:, update:) -> [init.module, update.module]
  }
  let update = case call.update {
    Some(ref) -> [ref.module]
    None -> []
  }
  list.flatten([[call.view.module], local, update])
}

fn init_local(
  call: app_call.AppCall,
  model_type: gleam_code.TypeExpr,
) -> Definition {
  let #(param, body) = case call.local {
    app_call.NoLocal -> #("_model", Ctor(None, "Nil"))
    app_call.LocalLayer(init:, ..) -> #("model", call_ref(init, [Var("model")]))
  }
  Function(
    "init_local",
    True,
    ["The first Local state, from the first synced Model."],
    [Param(param, model_type)],
    THole,
    [ExprStmt(body)],
  )
}

fn render(
  call: app_call.AppCall,
  model_type: gleam_code.TypeExpr,
) -> Definition {
  let #(local_param, view_args) = case call.kind {
    app_call.FullApplication -> #("local", [Var("model"), Var("local")])
    app_call.Simple | app_call.Application -> #("_local", [Var("model")])
  }
  Function(
    "render",
    True,
    ["The view as HTML, its handler table and its stream containers."],
    [Param("model", model_type), Param(local_param, THole)],
    THole,
    [
      ExprStmt(
        render_call("render_containers", [
          Call(Ref(Some(element), "to_node"), [
            Arg(call_ref(call.view, view_args)),
          ]),
        ]),
      ),
    ],
  )
}

fn update_local(
  call: app_call.AppCall,
  model_type: gleam_code.TypeExpr,
  msg_type: gleam_code.TypeExpr,
) -> Definition {
  let docs = ["The new Local state and whether the server needs the message."]
  case call.local {
    app_call.NoLocal ->
      Function(
        "update_local",
        True,
        docs,
        [
          Param("_model", model_type),
          Param("local", THole),
          Param("_msg", msg_type),
        ],
        THole,
        [ExprStmt(TupleExpr([Var("local"), Ctor(None, "True")]))],
      )
    app_call.LocalLayer(update:, ..) ->
      Function(
        "update_local",
        True,
        docs,
        [
          Param("model", model_type),
          Param("local", THole),
          Param("msg", msg_type),
        ],
        THole,
        [
          Let(
            PVar("brazier_update"),
            call_ref(update, [Var("model"), Var("local"), Var("msg")]),
          ),
          ExprStmt(
            TupleExpr([
              Call(Ref(Some(local_module), "new_local"), [
                Arg(Var("brazier_update")),
              ]),
              Call(Ref(Some(local_module), "is_forwarded"), [
                Arg(Var("brazier_update")),
              ]),
            ]),
          ),
        ],
      )
  }
}

/// `stream_names()` and the stream container exports
/// (docs/design/STREAMS.md 8.1).
fn stream_exports(
  analysis: Analysis,
  msg_type: gleam_code.TypeExpr,
) -> List(Definition) {
  let string = codec_gen.string_type()
  let dynamic = TNamed(Some(dynamic_module), "Dynamic", [])
  let container_type = TNamed(Some(render_module), "Container", [msg_type])
  let container = Param("container", container_type)
  let field = fn(label) { FieldAccess(Var("container"), label) }
  [
    Function(
      "stream_names",
      True,
      ["The streams the app declares, sorted."],
      [],
      TNamed(None, "List", [string]),
      [
        ExprStmt(ListExpr(list.map(server_codec.stream_names(analysis), Str))),
      ],
    ),
    Function(
      "container_name",
      True,
      ["The name of a rendered stream container's stream."],
      [container],
      string,
      [ExprStmt(field("name"))],
    ),
    Function(
      "container_keep",
      True,
      ["The end a container's limit keeps: \"first\" or \"last\"."],
      [container],
      string,
      [
        ExprStmt(
          Call(Ref(Some(stream_op_module), "keep_to_string"), [
            Arg(FieldAccess(field("limit"), "keep")),
          ]),
        ),
      ],
    ),
    Function(
      "container_limit",
      True,
      ["The number of items a container's limit keeps."],
      [container],
      int_type(),
      [ExprStmt(FieldAccess(field("limit"), "count"))],
    ),
    Function(
      "container_item",
      True,
      [
        "The container's item function, to compare with `===`: the same",
        "function gives the same value.",
      ],
      [container],
      dynamic,
      [ExprStmt(field("item_ref"))],
    ),
    Function(
      "render_item",
      True,
      [
        "One item of a container, from its parsed JSON: its HTML, keyed, and",
        "its handler table with item-relative ids.",
      ],
      [container, Param("key", string), Param("item", dynamic)],
      TNamed(None, "Result", [
        TTuple([string, TNamed(Some(render_module), "Handlers", [msg_type])]),
        string,
      ]),
      [
        ExprStmt(
          render_call("render_item", [Var("container"), Var("key"), Var("item")]),
        ),
      ],
    ),
  ]
}

fn simple_update(
  call: app_call.AppCall,
  model_type: gleam_code.TypeExpr,
  msg_type: gleam_code.TypeExpr,
) -> List(Definition) {
  case call.update {
    Some(update) -> [
      Function(
        "update",
        True,
        ["The app's update, applied before the server confirms it."],
        [Param("model", model_type), Param("msg", msg_type)],
        model_type,
        [ExprStmt(call_ref(update, [Var("model"), Var("msg")]))],
      ),
    ]
    None -> []
  }
}
