# Brazier CI image for unit, lint, and browser/CDP shard jobs.
#
# The browser harness needs Gleam/Erlang, Node/npm for esbuild, Python for CDP,
# and Chromium; git is for scripts/publish.sh (.github/workflows/publish.yml).
# Keep this image test-focused; the production Dockerfile remains separate.
FROM ghcr.io/gleam-lang/gleam:v1.19.2-erlang

WORKDIR /app

USER root

RUN if command -v apt-get >/dev/null 2>&1; then \
      apt-get update && \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        chromium \
        git \
        nodejs \
        npm \
        python3 \
        python3-pip \
        python3-venv \
        procps \
        lsof && \
      rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null 2>&1; then \
      apk add --no-cache \
        ca-certificates \
        chromium \
        git \
        lsof \
        nodejs \
        npm \
        procps \
        py3-pip \
        py3-virtualenv \
        python3; \
    else \
      echo "Unsupported base image package manager" >&2; \
      exit 1; \
    fi

COPY requirements-dev.txt ./
RUN python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt

COPY . .

ENV CHROME_BIN=/usr/bin/chromium
ENV CHROME_EXTRA_ARGS="--no-sandbox --disable-dev-shm-usage"
ENV PYTHON_BIN=/app/.venv/bin/python

# A fresh image has no build/ directory, so Gleam resolves every example's
# path dependency on the root again and looks each Hex package up through the
# Hex API: about 400 requests, past the unauthenticated limit of 100 a minute
# per IP that GitHub runners share. A read-only key (HEXPM_READ_API_KEY, which
# Gleam reads) raises that to the account's own limit. It is a BuildKit
# secret, so it is in no layer of the image; ci.yml requires it, a local build
# may leave it out.
RUN --mount=type=secret,id=hexpm_read_api_key,required=false \
    set -eu; \
    if [ -s /run/secrets/hexpm_read_api_key ]; then \
      HEXPM_READ_API_KEY="$(cat /run/secrets/hexpm_read_api_key)"; \
      export HEXPM_READ_API_KEY; \
      echo "Hex requests are authenticated with HEXPM_READ_API_KEY"; \
    else \
      echo "No hexpm_read_api_key secret: Hex requests are unauthenticated"; \
    fi; \
    gleam deps download; \
    for gleam_toml in examples/*/gleam.toml; do \
      example_dir="$(dirname "$gleam_toml")"; \
      (cd "$example_dir" && gleam deps download); \
    done

ARG BRAZIER_CDP_PREBUILD_EXAMPLES=0

RUN set -eu; \
    if [ "$BRAZIER_CDP_PREBUILD_EXAMPLES" = "1" ]; then \
      gleam build; \
      for gleam_toml in examples/*/gleam.toml; do \
        example_dir="$(dirname "$gleam_toml")"; \
        (cd "$example_dir" && gleam build); \
      done; \
    elif [ "$BRAZIER_CDP_PREBUILD_EXAMPLES" != "0" ]; then \
      echo "BRAZIER_CDP_PREBUILD_EXAMPLES must be 0 or 1" >&2; \
      exit 1; \
    fi

# Formatting first (cheapest, and an unformatted tree is not reviewed).
# Then the client JS checks: a missing or broken node fails here, by name,
# before the Gleam suite (whose node-driven tests would fail too). Each
# step must exit 0 for the next to run, and the job takes the first
# non-zero exit. The build must be warning-free (CLAUDE.md, Definition of
# Done), so warnings fail it. The docs check runs last: it compiles every
# Gleam sample in the docs against the API the steps before it checked.
CMD ["sh", "-lc", "gleam format --check src test && node --version && make test-client && gleam build --warnings-as-errors && gleam test && gleam run -m brazier/lint && scripts/check_docs.sh"]
