  case beacon_json.parse(data, beacon_envelope) {
    Ok(beacon_msg_json) -> decode_msg(beacon_msg_json)
    Error(_) -> Error("Client event missing generated Beacon message envelope")
  }
}

fn decode_msg(json_str: String) -> Result(beacon_app.Msg, String) {
  let beacon_tag_decoder = {
    use beacon_tag <- beacon_decode.field("tag", beacon_decode.string)
    beacon_decode.success(beacon_tag)
  }
  case beacon_json.parse(json_str, beacon_tag_decoder) {
    Ok(beacon_tag) ->
      case beacon_tag {
        "LeftUp" -> Ok(beacon_app.LeftUp)
        "LeftDown" -> Ok(beacon_app.LeftDown)
        "RightUp" -> Ok(beacon_app.RightUp)
        "RightDown" -> Ok(beacon_app.RightDown)
        "Tick" -> Ok(beacon_app.Tick)
        "StartGame" -> Ok(beacon_app.StartGame)
        "PauseGame" -> Ok(beacon_app.PauseGame)
        _ -> Error("Unknown generated Beacon message tag " <> beacon_tag)
      }
    Error(_) -> Error("Generated Beacon message payload missing tag")
  }
