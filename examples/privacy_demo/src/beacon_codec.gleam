/// Decode the Msg a client event carries in its `__beacon_msg` envelope.
/// Live event decoding never renders the view or reads the handler registry.
pub fn decode_event(
  _name: String,
  _handler_id: String,
  data: String,
  _target_path: String,
) -> Result(beacon_app.Msg, String) {
  let beacon_envelope = {
    use beacon_msg_json <- beacon_decode.field(
      "__beacon_msg",
      beacon_decode.string,
    )
    beacon_decode.success(beacon_msg_json)
  }
  case beacon_json.parse(data, beacon_envelope) {
    Ok(beacon_msg_json) -> decode_msg(beacon_msg_json)
    Error(_) -> Error("Client event missing generated Beacon message envelope")
  }
}

